{
  "cleanUrls": true,
  "functions": {
    "api/admin/docs/[action].js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
